# Пример окружения для docker compose: скопируйте в .env рядом с docker-compose.yml.
# Compose читает .env автоматически; файл с реальным ключом в репозиторий не попадает (.gitignore).

# Порт, на котором двойник отдаётся браузеру
WEB_PORT=8080

# Локальные порты для отладки: схема OpenAPI и OPC UA-сервер симулятора
API_PORT=8000
OPCUA_PORT=4840

# opcua-sim | sim | plant | off — см. комментарий в docker-compose.yml
SCADA_MODE=opcua-sim
# Запись в контроллеры: 0 — только чтение
SCADA_WRITE=0
# Глубина истории значений SCADA в сутках
SCADA_HISTORY_DAYS=7

# Ассистент и текстовые отчёты. Без ключа остальной ИИ (прогноз отказов, аномалии, причины брака) работает.
OPENAI_API_KEY=
AI_MODEL=gpt-4.1
AI_MODE=on
AI_LLM=on
